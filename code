services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: algoquest
      POSTGRES_USER: algoquest
      POSTGRES_PASSWORD: algoquest
    ports: ["5432:5432"]
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./infra/postgres/schema.sql:/docker-entrypoint-initdb.d/001-schema.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U algoquest -d algoquest"]
      interval: 5s
      timeout: 3s
      retries: 10

  redis:
    image: redis:7-alpine
    ports: ["6379:6379"]
    command: redis-server --appendonly yes
    volumes: [redis_data:/data]

  api:
    build:
      context: .
      dockerfile: services/api/Dockerfile
    env_file: .env
    environment:
      API_PORT: 4000
    ports: ["4000:4000"]
    depends_on:
      - postgres
      - redis
      - executor

  executor:
    build:
      context: .
      dockerfile: services/executor/Dockerfile
    env_file: .env
    environment:
      PORT: 5000
    # Production: deploy this behind an internal load balancer, not with the Docker socket.

  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://localhost:4000}
    environment:
      NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://localhost:4000}
    ports: ["3000:3000"]
    depends_on: [api]

volumes:
  postgres_data:
  redis_data:

{
  "name": "algoquest",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "dev:web": "pnpm --filter @algoquest/web dev",
    "dev:api": "pnpm --filter @algoquest/api dev",
    "build": "pnpm --filter @algoquest/web build",
    "typecheck": "pnpm --filter @algoquest/api typecheck && pnpm --filter @algoquest/executor typecheck",
    "test": "pnpm --if-present -r test"
  },
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@11.16.0"
}

